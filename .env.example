# Postgres connection string (docker compose up -d starts one on 5432)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shipwright
# Used only by the integration tests
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/shipwright_test
# 32+ character secret used to encrypt the session cookie (openssl rand -base64 32)
SESSION_SECRET=replace-me-with-a-32-character-or-longer-secret
# Base URL used for metadata and absolute links
NEXT_PUBLIC_APP_URL=http://localhost:3000
